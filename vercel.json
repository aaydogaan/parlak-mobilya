{
  "installCommand": "npm install --omit=dev --no-audit --no-fund",
  "trailingSlash": false,
  "headers": [
    {
      "source": "/images/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/videos/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/ozel-olcu-mobilya-yaptirmadan-once-dikkat-edilmesi-gerekenler",
      "destination": "/blog/ozel-olcu-mobilya-yaptirmadan-once-dikkat-edilmesi-gerekenler",
      "permanent": true
    },
    {
      "source": "/yeni-web-sitemiz-yayinda",
      "destination": "/blog/yeni-web-sitemiz-yayinda",
      "permanent": true
    }
  ]
}
